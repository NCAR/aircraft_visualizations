# Aircraft Visualization Environment Variables
# Copy this file to .env and update with your actual paths

# Server Configuration
PORT=3000
NODE_ENV=development

# Data Directories (for legacy file-based endpoints)
DATA_DIR=/scr/raf_data
RAW_DATA_DIR=/scr/raf_Raw_Data

# PostgreSQL Configuration - Historical Data
PG_HOST=eol-rosetta.eol.ucar.edu
PG_PORT=5432
PG_DATABASE=aircraft_data
PG_USER=ads
PG_PASSWORD=your_password_here

# PostgreSQL Configuration - Real-time Data
RT_PG_HOST=eol-rt-data.eol.ucar.edu
RT_PG_PORT=5432
RT_PG_DATABASE=real-time-C130
RT_PG_USER=ads
RT_PG_PASSWORD=your_realtime_password_here

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# GitHub Configuration (for issue submission)
# Create a personal access token with 'repo' scope at https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here
